Example 1:

Input: x = 121
Output: true
Explanation: 121 reads as 121 from left to right and from right to left.

SOLUTION:

class Solution {
    public boolean isPalindrome(int x) {
        while(x<0){
            return false;
        }
        int rev=0;
        int copy=x;
        while(x>0){
            rev=(rev*10)+(x%10);
            x/=10;
        }
        return copy==rev;
    }
}
